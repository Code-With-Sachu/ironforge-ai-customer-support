# ---- AI (Google Gemini) ----
# Add your real key only to .env, never to .env.example.
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- Admin panel ----
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Long random string used to sign admin sessions.
SESSION_SECRET=

# Private URL for the admin panel (default: /admin)
ADMIN_PATH=admin

# ---- Server ----
PORT=3000

# Timezone of the gym
GYM_TIMEZONE=Asia/Kolkata

# Set to production when deployed behind HTTPS
NODE_ENV=development